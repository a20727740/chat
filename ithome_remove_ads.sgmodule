
#!desc=移除移动Web与APP中的广告
#!author=chouchoui（原脚本），整理 by ChatGPT
#!homepage=https://github.com/chouchoui/QuanX
#!category=Adblock

[Script]
移动Web新闻广告 = type=http-response,pattern=^https:\/\/m\.ithome\.com\/api\/news\/newslistpageget,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/chouchoui/QuanX/master/Scripts/ithome/ithome.ad.js,script-update-interval=0
APP新闻广告 = type=http-response,pattern=^https:\/\/api\.ithome\.com\/json\/(listpage|newslist)\/news,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/chouchoui/QuanX/master/Scripts/ithome/ithome.ad.js,script-update-interval=0
APP轮播广告 = type=http-response,pattern=^https:\/\/api\.ithome\.com\/json\/slide\/index,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/chouchoui/QuanX/master/Scripts/ithome/ithome.ad.js,script-update-interval=0
napi广告 = type=http-response,pattern=^https:\/\/napi\.ithome\.com\/api\/(news|topmenu)\/(getfeeds|index),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/chouchoui/QuanX/master/Scripts/ithome/ithome.ad.js,script-update-interval=0

[URL Rewrite]
^https:\/\/api\.zuihuimai\.com - reject
